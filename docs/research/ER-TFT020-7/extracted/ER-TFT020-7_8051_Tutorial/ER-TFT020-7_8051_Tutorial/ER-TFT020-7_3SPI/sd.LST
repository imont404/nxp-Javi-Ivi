 180          //=======================================================================
 181          //Specified address from the SD card to read data, a maximum of 512 bytes
 182          unsigned char SdReadBlock(unsigned char *Block, unsigned long address,int len)
 183          {
 184   1      unsigned int count;
 185   1      //Block size is 512 bytes exactly
 186   1      //First Lower SS
 187   1      
 188   1       //printf("MMC_read_block\n");
 189   1      
 190   1      SD_CS=0;
 191   1      //Then send write command
 192   1      SdCommand(0x11,address,0xff);
 193   1      
 194   1      if(SdResponse()==00)
 195   1      {
 196   2      //command was a success - now send data
 197   2      //start with DATA TOKEN = 0xFE
 198   2      while(SdRead()!=0xfe);
 199   2      
 200   2      for(count=0;count<len;count++) *Block++=SdRead(); 
 201   2      
 202   2      for(;count<512;count++) SdRead();
 203   2      
 204   2      //data block sent - now send checksum
 205   2      SdRead();
 206   2      SdRead();
 207   2      //Now read in the DATA RESPONSE token
 208   2      SD_CS=1;
 209   2      SdRead();
 210   2      return 1;
 211   2      }
 212   1       //printf("Command 0x11 (Read) was not received by the MMC.\n");
 213   1      return 0;
 214   1      }
