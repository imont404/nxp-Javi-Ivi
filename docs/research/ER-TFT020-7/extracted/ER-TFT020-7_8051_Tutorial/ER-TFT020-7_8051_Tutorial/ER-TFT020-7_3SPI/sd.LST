  56   2      
  57   2      }
  58   1      return n;
  59   1      }
  60          //============================================================
  61          //Detecting the response of the SD card
  62          unsigned char SdResponse()
  63          {
  64   1      unsigned char i=0,response;
  65   1      
  66   1      while(i<=8)
  67   1      {
  68   2      response = SdRead();
  69   2      if(response==0x00)
  70   2      break;
  71   2      if(response==0x01)
  72   2      break;
  73   2      i++;
  74   2      }
  75   1      return response;
  76   1      } 
  77          //================================================================
  78          //Send commands to the SD card
  79          void SdCommand(unsigned char command, unsigned long argument, unsigned char CRC)
  80          {
  81   1      
  82   1      SdWrite(command|0x40);
  83   1      SdWrite(((unsigned char *)&argument)[0]);
  84   1      SdWrite(((unsigned char *)&argument)[1]);
  85   1      SdWrite(((unsigned char *)&argument)[2]);
  86   1      SdWrite(((unsigned char *)&argument)[3]);
  87   1      SdWrite(CRC);
  88   1      }
  89          //================================================================
  90          //Initialize the SD card
  91          unsigned char SdInit(void)
  92          {
  93   1      int delay=0, trials=0;
  94   1      unsigned char i;
  95   1      unsigned char response=0x01;
  96   1      
  97   1      SD_CS=1;
  98   1      for(i=0;i<=9;i++)
  99   1      SdWrite(0xff);
 100   1      SD_CS=0;
 101   1      
 102   1      //Send Command 0 to put MMC in SPI mode
 103   1      SdCommand(0x00,0,0x95);
 104   1      
 105   1      
 106   1      response=SdResponse();
