  29          //===========================================================
  30          //write one byte to SD
  31          void SdWrite(unsigned char n)
  32          {
  33   1      
  34   1      unsigned char i;
  35   1      
  36   1      for(i=8;i;i--)
  37   1      {
  38   2      SD_CLK=0;
  39   2      SD_DI=(n&0x80);
  40   2      n<<=1;
  41   2      SD_CLK=1;
  42   2      }
  43   1      SD_DI=1; 
  44   1      } 
  45          //===========================================================
  46          //read one byte
  47          unsigned char SdRead()
  48          {
  49   1      unsigned char n,i;
  50   1      for(i=8;i;i--)
  51   1      {
  52   2      SD_CLK=0;
  53   2      SD_CLK=1;
  54   2      n<<=1;
  55   2      if(SD_DO) n|=1;
