 126          //================================================================
 127          //Specify the address to write  the SD card data, a maximum of 512 bytes
 128          unsigned char SdWriteBlock(unsigned char *Block, unsigned long address,int len)
 129          {
 130   1      unsigned int count;
 131   1      unsigned char dataResp;
 132   1      //Block size is 512 bytes exactly
 133   1      //First Lower SS
 134   1      
 135   1      SD_CS=0;
 136   1      //Then send write command
 137   1      SdCommand(0x18,address,0xff);
 138   1      
 139   1      if(SdResponse()==00)
 140   1      {
 141   2      SdWrite(0xff);
 142   2      SdWrite(0xff);
 143   2      SdWrite(0xff);
 144   2      //command was a success - now send data
 145   2      //start with DATA TOKEN = 0xFE
 146   2      SdWrite(0xfe);
 147   2      //now send data
 148   2      for(count=0;count<len;count++) SdWrite(*Block++);
 149   2      
 150   2      for(;count<512;count++) SdWrite(0);
 151   2      //data block sent - now send checksum
 152   2      SdWrite(0xff); 
 153   2      SdWrite(0xff);
 154   2      //Now read in the DATA RESPONSE token
 155   2      dataResp=SdRead();
 156   2      //Following the DATA RESPONSE token
 157   2      //are a number of BUSY bytes
 158   2      //a zero byte indicates the MMC is busy
 159   2      
 160   2      while(SdRead()==0);
 161   2      
 162   2      dataResp=dataResp&0x0f; //mask the high byte of the DATA RESPONSE token
 163   2      SD_CS=1;
 164   2      SdWrite(0xff);
 165   2      if(dataResp==0x0b)
 166   2      {
 167   3      //printf("DATA WAS NOT ACCEPTED BY CARD -- CRC ERROR\n");
 168   3      return 0;
 169   3      }
 170   2      if(dataResp==0x05)
 171   2      return 1;
 172   2      
 173   2      //printf("Invalid data Response token.\n");
 174   2      return 0;
 175   2      }
 176   1      //printf("Command 0x18 (Write) was not received by the MMC.\n");
 177   1      return 0;
 178   1      }
