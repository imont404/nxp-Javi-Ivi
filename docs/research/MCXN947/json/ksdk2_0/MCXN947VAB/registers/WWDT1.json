{
  "peripheral": {
    "@_xmlns": {
      "regs": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
      "xsi": "http://www.w3.org/2001/XMLSchema-instance"
    },
    "@schemaLocation": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
    "register": [
      {
        "@offset": "0",
        "@width": "32",
        "@name": "MOD",
        "@description": "Mode",
        "alias": {
          "@type": "CMSIS",
          "@value": "MOD"
        },
        "bit_field": [
          {
            "@offset": "0",
            "@width": "1",
            "@name": "WDEN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Watchdog Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "WWDT_MOD_WDEN(x)"
            },
            "bit_field_value": [
              {
                "@name": "MOD_WDEN_STOP",
                "@value": "0b0",
                "@description": "Timer stopped"
              },
              {
                "@name": "MOD_WDEN_RUN",
                "@value": "0b1",
                "@description": "Timer running"
              }
            ]
          },
          {
            "@offset": "1",
            "@width": "1",
            "@name": "WDRESET",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Watchdog Reset Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "WWDT_MOD_WDRESET(x)"
            },
            "bit_field_value": [
              {
                "@name": "MOD_WDRESET_INTERRUPT",
                "@value": "0b0",
                "@description": "Interrupt"
              },
              {
                "@name": "MOD_WDRESET_RESET",
                "@value": "0b1",
                "@description": "Reset"
              }
            ]
          },
          {
            "@offset": "2",
            "@width": "1",
            "@name": "WDTOF",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Watchdog Timeout Flag",
            "alias": {
              "@type": "CMSIS",
              "@value": "WWDT_MOD_WDTOF(x)"
            },
            "bit_field_value": [
              {
                "@name": "MOD_WDTOF_CLEAR",
                "@value": "0b0",
                "@description": "Watchdog event has not occurred."
              },
              {
                "@name": "MOD_WDTOF_RESET",
                "@value": "0b1",
                "@description": "Watchdog event has occurred (causes a chip reset if WDRESET = 1)."
              }
            ]
          },
          {
            "@offset": "3",
            "@width": "1",
            "@name": "WDINT",
            "@access": "W1C",
            "@reset_value": "0",
            "@description": "Warning Interrupt Flag",
            "alias": {
              "@type": "CMSIS",
              "@value": "WWDT_MOD_WDINT(x)"
            },
            "bit_field_value": [
              {
                "@name": "MOD_WDINT_NO_FLAG",
                "@value": "0b0",
                "@description": "No flag"
              },
              {
                "@name": "MOD_WDINT_FLAG",
                "@value": "0b1",
                "@description": "Flag"
              }
            ]
          },
          {
            "@offset": "4",
            "@width": "1",
            "@name": "WDPROTECT",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Watchdog Update Mode",
            "alias": {
              "@type": "CMSIS",
              "@value": "WWDT_MOD_WDPROTECT(x)"
            },
            "bit_field_value": [
              {
                "@name": "MOD_WDPROTECT_FLEXIBLE",
                "@value": "0b0",
                "@description": "Flexible"
              },
              {
                "@name": "MOD_WDPROTECT_THRESHOLD",
                "@value": "0b1",
                "@description": "Threshold"
              }
            ]
          },
          {
            "@offset": "5",
            "@width": "1",
            "@name": "LOCK",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Lock",
            "alias": {
              "@type": "CMSIS",
              "@value": "WWDT_MOD_LOCK(x)"
            },
            "bit_field_value": [
              {
                "@name": "MOD_LOCK_NO_LOCK",
                "@value": "0b0",
                "@description": "No Lock"
              },
              {
                "@name": "MOD_LOCK_LOCK",
                "@value": "0b1",
                "@description": "Lock"
              }
            ]
          },
          {
            "@offset": "6",
            "@width": "1",
            "@name": "DEBUG_EN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Debug Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "WWDT_MOD_DEBUG_EN(x)"
            },
            "bit_field_value": [
              {
                "@name": "MOD_DEBUG_EN_DISABLE",
                "@value": "0b0",
                "@description": "Disabled"
              },
              {
                "@name": "MOD_DEBUG_EN_ENABLE",
                "@value": "0b1",
                "@description": "Enabled"
              }
            ]
          }
        ],
        "reserved_bit_field": {
          "@offset": "7",
          "@width": "25",
          "@reset_value": "0"
        }
      },
      {
        "@offset": "0x4",
        "@width": "32",
        "@name": "TC",
        "@description": "Timer Constant",
        "alias": {
          "@type": "CMSIS",
          "@value": "TC"
        },
        "bit_field": {
          "@offset": "0",
          "@width": "24",
          "@name": "COUNT",
          "@access": "RW",
          "@reset_value": "0xFF",
          "@description": "Watchdog Timeout Value",
          "alias": {
            "@type": "CMSIS",
            "@value": "WWDT_TC_COUNT(x)"
          }
        },
        "reserved_bit_field": {
          "@offset": "24",
          "@width": "8",
          "@reset_value": "0"
        }
      },
      {
        "@offset": "0x8",
        "@width": "32",
        "@name": "FEED",
        "@description": "Feed Sequence",
        "alias": {
          "@type": "CMSIS",
          "@value": "FEED"
        },
        "bit_field": {
          "@offset": "0",
          "@width": "8",
          "@name": "FEED",
          "@access": "WO",
          "@reset_value": "0",
          "@reset_mask": "0",
          "@description": "Feed Value",
          "alias": {
            "@type": "CMSIS",
            "@value": "WWDT_FEED_FEED(x)"
          }
        },
        "reserved_bit_field": {
          "@offset": "8",
          "@width": "24",
          "@reset_value": "0",
          "@reset_mask": "0"
        }
      },
      {
        "@offset": "0xC",
        "@width": "32",
        "@name": "TV",
        "@description": "Timer Value",
        "alias": {
          "@type": "CMSIS",
          "@value": "TV"
        },
        "bit_field": {
          "@offset": "0",
          "@width": "24",
          "@name": "COUNT",
          "@access": "RO",
          "@reset_value": "0xFF",
          "@description": "Counter Timer Value",
          "alias": {
            "@type": "CMSIS",
            "@value": "WWDT_TV_COUNT(x)"
          }
        },
        "reserved_bit_field": {
          "@offset": "24",
          "@width": "8",
          "@reset_value": "0"
        }
      },
      {
        "@offset": "0x14",
        "@width": "32",
        "@name": "WARNINT",
        "@description": "Warning Interrupt Compare Value",
        "alias": {
          "@type": "CMSIS",
          "@value": "WARNINT"
        },
        "bit_field": {
          "@offset": "0",
          "@width": "10",
          "@name": "WARNINT",
          "@access": "RW",
          "@reset_value": "0",
          "@description": "Watchdog Warning Interrupt Compare Value",
          "alias": {
            "@type": "CMSIS",
            "@value": "WWDT_WARNINT_WARNINT(x)"
          }
        },
        "reserved_bit_field": {
          "@offset": "10",
          "@width": "22",
          "@reset_value": "0"
        }
      },
      {
        "@offset": "0x18",
        "@width": "32",
        "@name": "WINDOW",
        "@description": "Window Compare Value",
        "alias": {
          "@type": "CMSIS",
          "@value": "WINDOW"
        },
        "bit_field": {
          "@offset": "0",
          "@width": "24",
          "@name": "WINDOW",
          "@access": "RW",
          "@reset_value": "0xFFFFFF",
          "@description": "Watchdog Window Value",
          "alias": {
            "@type": "CMSIS",
            "@value": "WWDT_WINDOW_WINDOW(x)"
          }
        },
        "reserved_bit_field": {
          "@offset": "24",
          "@width": "8",
          "@reset_value": "0"
        }
      }
    ]
  }
}