            "@width": "1",
            "@name": "HCBGEN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "HC Bandgap Enabled",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_CSR_HCBGEN(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_HCBGEN_DIS",
                "@value": "0b0",
                "@description": "Disables"
              },
              {
                "@name": "CSR_HCBGEN_ENA",
                "@value": "0b1",
                "@description": "Enables"
              }
            ]
          },
          {
            "@offset": "1",
            "@width": "1",
            "@name": "LPBGEN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Low-Power Bandgap Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_CSR_LPBGEN(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_LPBGEN_DIS",
                "@value": "0b0",
                "@description": "Disables"
              },
              {
                "@name": "CSR_LPBGEN_ENA",
                "@value": "0b1",
                "@description": "Enables"
              }
            ]
          },
          {
            "@offset": "2",
            "@width": "1",
            "@name": "LPBG_BUF_EN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Low-Power Bandgap Buffer Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_CSR_LPBG_BUF_EN(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_LPBG_BUF_EN_DIS",
                "@value": "0b0",
                "@description": "Disables"
              },
              {
                "@name": "CSR_LPBG_BUF_EN_ENA",
                "@value": "0b1",
                "@description": "Enables"
              }
            ]
          },
          {
            "@offset": "3",
            "@width": "1",
            "@name": "CHOPEN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Chop Oscillator Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_CSR_CHOPEN(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_CHOPEN_DIS",
                "@value": "0b0",
                "@description": "Disables"
              },
              {
                "@name": "CSR_CHOPEN_ENA",
                "@value": "0b1",
                "@description": "Enables"
              }
            ]
          },
          {
            "@offset": "4",
            "@width": "1",
            "@name": "ICOMPEN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Current Compensation Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_CSR_ICOMPEN(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_ICOMPEN_DIS",
                "@value": "0b0",
                "@description": "Disables"
              },
              {
                "@name": "CSR_ICOMPEN_ENA",
                "@value": "0b1",
                "@description": "Enables"
              }
            ]
          },
          {
            "@offset": "5",
            "@width": "1",
            "@name": "REGEN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Regulator Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_CSR_REGEN(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_REGEN_DIS",
                "@value": "0b0",
                "@description": "Disables"
              },
              {
                "@name": "CSR_REGEN_ENA",
                "@value": "0b1",
                "@description": "Enables"
              }
            ]
          },
          {
            "@offset": "11",
            "@width": "1",
            "@name": "HI_PWR_LV",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "High-Power Level",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_CSR_HI_PWR_LV(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_HI_PWR_LV_LOW",
                "@value": "0b0",
                "@description": "Low-power"
              },
              {
                "@name": "CSR_HI_PWR_LV_HIGH",
                "@value": "0b1",
                "@description": "High-power"
              }
            ]
