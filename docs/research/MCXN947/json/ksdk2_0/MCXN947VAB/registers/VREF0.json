        "reserved_bit_field": [
          {
            "@offset": "4",
            "@width": "4",
            "@reset_value": "0",
            "@reset_mask": "0"
          },
          {
            "@offset": "14",
            "@width": "18",
            "@reset_value": "0",
            "@reset_mask": "0"
          }
