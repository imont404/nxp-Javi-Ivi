{
  "peripheral": {
    "@_xmlns": {
      "regs": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
      "xsi": "http://www.w3.org/2001/XMLSchema-instance"
    },
    "@schemaLocation": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
    "register": [
      {
        "@offset": "0",
        "@width": "32",
        "@name": "VERID",
        "@description": "Version ID",
        "alias": {
          "@type": "CMSIS",
          "@value": "VERID"
        },
        "bit_field": [
          {
            "@offset": "0",
            "@width": "16",
            "@name": "FEATURE",
            "@access": "RO",
            "@reset_value": "0",
            "@description": "Feature Specification Number",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_VERID_FEATURE(x)"
            }
          },
          {
            "@offset": "16",
            "@width": "8",
            "@name": "MINOR",
            "@access": "RO",
            "@reset_value": "0",
            "@description": "Minor Version Number",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_VERID_MINOR(x)"
            }
          },
          {
            "@offset": "24",
            "@width": "8",
            "@name": "MAJOR",
            "@access": "RO",
            "@reset_value": "0x1",
            "@description": "Major Version Number",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_VERID_MAJOR(x)"
            }
          }
        ]
      },
