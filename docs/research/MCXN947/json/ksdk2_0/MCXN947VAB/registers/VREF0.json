            "@width": "6",
            "@name": "VREFTRIM",
            "@access": "RW",
            "@reset_value": "0",
            "@reset_mask": "0",
            "@description": "VREF Trim",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_UTRIM_VREFTRIM(x)"
            }
          }
