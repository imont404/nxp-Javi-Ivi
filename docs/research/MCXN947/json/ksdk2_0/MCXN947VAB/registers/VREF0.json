            "alias": [
              {
                "@type": "CMSIS",
                "@value": "VREF_CSR_BUF21EN(x)"
              },
              {
                "@type": "id",
                "@value": "VREF2P1EN"
              }
            ],
            "bit_field_value": [
              {
                "@name": "CSR_BUF21EN_DIS",
                "@value": "0b0",
                "@description": "Disables"
              },
              {
                "@name": "CSR_BUF21EN_ENA",
                "@value": "0b1",
                "@description": "Enables"
              }
            ]
          },
          {
            "@offset": "31",
            "@width": "1",
            "@name": "VREFST",
            "@access": "RO",
            "@reset_value": "0",
            "@description": "Internal HC Voltage Reference Stable",
            "alias": {
              "@type": "CMSIS",
              "@value": "VREF_CSR_VREFST(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_VREFST_DIS_NOTSTABLE",
                "@value": "0b0",
                "@description": "Disabled and unstable"
              },
              {
                "@name": "CSR_VREFST_STABLE",
                "@value": "0b1",
                "@description": "Stable"
              }
            ]
          }
        ],
        "reserved_bit_field": [
          {
            "@offset": "6",
            "@width": "5",
            "@reset_value": "0"
          },
          {
            "@offset": "12",
            "@width": "4",
            "@reset_value": "0"
          },
          {
            "@offset": "17",
            "@width": "14",
            "@reset_value": "0"
          }
