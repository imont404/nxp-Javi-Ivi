            "@name": "XN",
            "@access": "RW",
            "@reset_value": "0",
            "@reset_mask": "0",
            "@description": "The XN bit is an Execute Never bit, that indicates whether the processor can execute instructions from the region.",
            "bit_field_value": [
              {
                "@name": "RBAR_A{1}_XN_EXECUTE",
                "@value": "0b0",
                "@description": "Execution is only permitted if read permitted."
              },
              {
                "@name": "RBAR_A{1}_XN_EXECUTE_NEVER",
                "@value": "0b1",
                "@description": "Execution is not permitted."
              }
            ]
          },
          {
