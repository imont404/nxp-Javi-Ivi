{
  "component": {
    "@_xmlns": {
      "clocks": "http://apif.freescale.net/schemas/clocks/1.2",
      "xsi": "http://www.w3.org/2001/XMLSchema-instance"
    },
    "@schemaLocation": "http://apif.freescale.net/schemas/clocks/1.2 http://apif.nxp.com/schemas/clocks/1.2/clocks.xsd",
    "@id": "USB_PHY",
    "instance_header": {
      "instance_description": "Clock model for the USB PHY PLL module (parameterized, shared accross K-family parts)"
    },
    "interface": {
      "input_clock_signal": {
        "@id": "CLK_IN",
        "@name": "CLK_IN",
        "@description": "Clock source from crystal (12MHz, 16MHz, 19.2MHz, 20MHz, 24MHz, 30MHz or 32MHz)"
      },
      "output_clock_signal": [
        {
          "@id": "USB_PLL_CLK",
          "@name": "USB_PLL_CLK",
          "@description": "PFD output clock (up to 180MHz)"
        },
        {
          "@id": "USB_HSPLL_CLK",
          "@name": "USB_HSPLL_CLK",
          "@description": "USBPHY PLL output clock (480MHz)"
        }
      ]
    },
    "implementation": {
      "configuration_element": {
        "@id": "USBPHYConfig",
        "@name": "Initialize USBPHY clock",
        "@description": "The USBPHY PFD clock initialization. When the USBPHY is enabled the OSCERCLK outputs are also enabled to provide USB PHY clock source.",
        "default": {
          "@value": "no"
        },
        "item": [
          {
            "@id": "no",
            "@description": "no"
          },
          {
            "@id": "PLL",
            "@description": "PLL only (480MHz for USB HS)",
            "long_description": "Enable the USB PHY PLL initialization (480MHz) for the USB HS.    \n              This value also enables the OSCERCLK and OSCERCLK_UNDIV output by setting of the ERCLKEN bit in the OSC control register."
          },
          {
            "@id": "PFD",
            "@description": "PFD clock only",
            "long_description": "Enable the USB PFD clock initialization without the PLL (USBPHY PLL is disabled).    \n              This value also enables the OSCERCLK and OSCERCLK_UNDIV output by setting of the ERCLKEN bit in the OSC control register.",
            "assigns": {
              "assign": {
                "@register": "USBPHY::ANACTRL",
                "@bit_field": "PFD_CLK_SEL",
                "@value": "0"
              }
            }
          },
          {
            "@id": "PLL_PFD",
            "@description": "PLL and PFD clock",
            "long_description": "Enable the full initialization of the USBPHY PLL and USB PFD clock.    \n              This value also enables the OSCERCLK and OSCERCLK_UNDIV output by setting of the ERCLKEN bit in the OSC control register."
          },
          {
            "@id": "User_PLL_PFD",
            "@description": "User code (PLL and PFD clock)",
            "long_description": "Enable the configuration of the USBPHY PLL and USB PFD clock but the initialization subroutine must be implemented by the user code (declaration of the initialization functions is provided only). See the generated code.    \n              This value also enables the OSCERCLK and OSCERCLK_UNDIV output by setting of the ERCLKEN bit in the OSC control register."
          }
        ]
      },
      "pll": {
        "@id": "PLL",
        "@name": "USB PLL",
        "@description": "USB PHY PLL 480MHz (it support 12MHz, 16MHz, 19.2MHz, 20MHz, 24MHz, 30MHz or 32MHz input frequencies only)",
        "input": {
          "@signal": "CLK_IN"
        },
        "enable": {
          "@power_modes": "ACTIVE SLEEP",
          "@cond_expr": "(USBPHYConfig != `no`) && (USBPHYConfig != `PFD`) && (RunPowerMode != `MD`)",
          "@description": "Disabled in Middrive run power mode"
        },
        "prescaler": [
          {
            "@id": "NO_DIV",
            "@name": "NO_DIV",
            "@description": "No divider",
            "divide": {
              "@expr": "1"
            }
          },
          {
            "@id": "DIV",
            "@name": "DIV",
            "@description": "PLL clock",
            "value_map": {
              "@expr": "USBPHY::PLL_SIC[PLL_DIV_SEL]",
              "multiply": [
                {
                  "@expr": "15",
                  "@ctrl_value": "0b000",
                  "constraint": [
                    {
                      "@freq": "480 MHz"
                    },
                    {
                      "@relates_to": "input",
                      "@freq": "32 MHz"
                    }
                  ]
                },
                {
                  "@expr": "16",
                  "@ctrl_value": "0b001",
                  "constraint": [
                    {
                      "@freq": "480 MHz"
                    },
                    {
                      "@relates_to": "input",
                      "@freq": "30 MHz"
                    }
                  ]
                },
                {
                  "@expr": "20",
                  "@ctrl_value": "0b010",
                  "constraint": [
                    {
                      "@freq": "480 MHz"
                    },
                    {
                      "@relates_to": "input",
                      "@freq": "24 MHz"
                    }
                  ]
                },
                {
                  "@expr": "24",
                  "@ctrl_value": "0b100",
                  "constraint": [
                    {
                      "@freq": "480 MHz"
                    },
                    {
                      "@relates_to": "input",
                      "@freq": "20 MHz"
                    }
                  ]
                },
                {
                  "@expr": "25",
                  "@ctrl_value": "0b101",
                  "constraint": [
                    {
                      "@freq": "480 MHz"
                    },
                    {
                      "@relates_to": "input",
                      "@freq": "19.2 MHz"
                    }
                  ]
                },
                {
                  "@expr": "30",
                  "@ctrl_value": "0b110",
                  "constraint": [
                    {
                      "@freq": "480 MHz"
                    },
                    {
                      "@relates_to": "input",
                      "@freq": "16 MHz"
                    }
                  ]
                },
                {
                  "@expr": "40",
                  "@ctrl_value": "0b111",
                  "constraint": [
                    {
                      "@freq": "480 MHz"
                    },
                    {
                      "@relates_to": "input",
                      "@freq": "12 MHz"
                    }
                  ]
                }
              ]
            },
            "constraint": {
              "@freq": "480 MHz"
            }
          }
        ]
      },
      "prescaler": [
        {
          "@id": "PFD_FRAC_MUL",
          "@name": "PFD_FRAC_MUL",
          "@description": "PFD fractional divider - multiplier part (fixed)",
          "input": {
            "@signal": "PLL.clk"
          },
          "multiply": {
            "@expr": "18"
          },
          "enable": {
            "@cond_expr": "(USBPHYConfig != `no`) && (USBPHYConfig != `PLL`)"
          }
        },
        {
          "@id": "PFD_FRAC_DIV",
          "@name": "PFD_FRAC_DIV",
          "@description": "PFD fractional divider - divider part",
          "@min": "18",
          "@max": "35",
          "input": {
            "@signal": "PFD_FRAC_MUL.clk"
          },
          "divide": {
            "@expr": "USBPHY::PFDA[PFD0_FRAC]"
          },
          "enable": {
            "@cond_expr": "(USBPHYConfig != `no`) && (USBPHYConfig != `PLL`)"
          },
          "constraint": {
            "@cond_expr": "(USBPHY::PFDA[PFD0_FRAC]>=18) && (USBPHY::PFDA[PFD0_FRAC]<=35)"
          }
        },
        {
          "@id": "PFD_CLK_DIV2",
          "@name": "PFD_CLK_DIV2",
          "@description": "PFD divider by 2 for the clock selector",
          "input": {
            "@signal": "PFD_FRAC_DIV.clk"
          },
          "divide": {
            "@expr": "2"
          },
          "enable": {
            "@cond_expr": "(USBPHYConfig != `no`) && (USBPHYConfig != `PLL`)"
          }
        },
        {
          "@id": "PFD_CLK_DIV4",
          "@name": "PFD_CLK_DIV4",
          "@description": "PFD divider by 4 for the clock selector",
          "input": {
            "@signal": "PFD_FRAC_DIV.clk"
          },
          "divide": {
            "@expr": "4"
          },
          "enable": {
            "@cond_expr": "(USBPHYConfig != `no`) && (USBPHYConfig != `PLL`)"
          }
        }
      ],
      "clock_select": {
        "@id": "PFD_CLK_SEL",
        "@name": "PFD_CLK_SEL",
        "@description": "PFD clock selector for output clock signal",
        "value_map": {
          "@expr": "USBPHY::ANACTRL[PFD_CLK_SEL]",
          "input": [
            {
              "@ctrl_value": "0",
              "@signal": "CLK_IN",
              "@name": "Bypass of the PLL",
              "@description": "USB1PFDCLK is the same frequency as the xtal clock (Default)"
            },
            {
              "@ctrl_value": "1",
              "@signal": "PFD_CLK_DIV4.clk",
              "@name": "PLL (pfd_clk) clock divided by 4",
              "@description": "USB1PFDCLK frequency is pfd_clk divided by 4"
            },
            {
              "@ctrl_value": "2",
              "@signal": "PFD_CLK_DIV2.clk",
              "@name": "PLL (pfd_clk) clock divided by 2",
              "@description": "USB1PFDCLK frequency is pfd_clk divided by 2"
            },
            {
              "@ctrl_value": "3",
              "@signal": "PFD_FRAC_DIV.clk",
              "@name": "PLL (pfd_clk) clock",
              "@description": "USB1PFDCLK frequency is the same as pfd_clk frequency"
            }
          ]
        },
        "enable": {
          "@cond_expr": "(USBPHYConfig != `no`) && (USBPHYConfig != `PLL`) && (RunPowerMode != `MD`) ",
          "@description": "Disabled in Middrive run power mode"
        }
      },
      "map_output": [
        {
          "@id": "USB_PLL_CLK",
          "input": {
            "@signal": "PFD_CLK_SEL.clk"
          },
          "enable": {
            "@power_modes": "ACTIVE SLEEP",
            "@cond_expr": "(USBPHYConfig != `no`) && (USBPHYConfig != `PLL`)",
            "@description": "Enabled in Run and High speed run modes only"
          },
          "constraint": [
            {
              "@max_freq": "150 MHz",
              "@when": "RunPowerMode==`OD`"
            },
            {
              "@max_freq": "100 MHz",
              "@when": "RunPowerMode==`SD`"
            },
            {
              "@max_freq": "50 MHz",
              "@when": "RunPowerMode==`MD`"
            }
          ],
          "configuration_element": {
            "@id": "SCG_UPLLCSR_MONITOR_CFG",
            "@name": "UPLL monitor mode selection",
            "@description": "Configuration of System PLL monitor mode (disabled, interrupt when the UPLL error is detected. or reset when error detected).",
            "default": {
              "@value": "Disabled"
            },
            "item": [
              {
                "@id": "Disabled",
                "@description": "Clock Monitor is disabled",
                "long_description": "System PLL Clock Monitor is disabled(UPLLCSR[UPLLCMRE] is not used).",
                "assigns": {
                  "assign": [
                    {
                      "@register": "SCG0::UPLLCSR",
                      "@bit_field": "UPLLCM",
                      "@value": "0"
                    },
                    {
                      "@register": "SCG0::UPLLCSR",
                      "@bit_field": "UPLLCMRE",
                      "@value": "0"
                    }
                  ]
                }
              },
              {
                "@id": "Interrupt",
                "@description": "Interrupt when the UPLL clock error is detected.",
                "long_description": "System PLL Clock Monitor is enabled, clock Monitor generates interrupt when error detected.",
                "assigns": {
                  "assign": [
                    {
                      "@register": "SCG0::UPLLCSR",
                      "@bit_field": "UPLLCM",
                      "@value": "1"
                    },
                    {
                      "@register": "SCG0::UPLLCSR",
                      "@bit_field": "UPLLCMRE",
                      "@value": "0"
                    }
                  ]
                }
              },
              {
                "@id": "Reset",
                "@description": "Reset when the UPLL clock error is detected.",
                "long_description": "System PLL Clock Monitor is enabled, clock Monitor generates reset when error detected.",
                "assigns": {
                  "assign": [
                    {
                      "@register": "SCG0::UPLLCSR",
                      "@bit_field": "UPLLCM",
                      "@value": "1"
                    },
                    {
                      "@register": "SCG0::UPLLCSR",
                      "@bit_field": "UPLLCMRE",
                      "@value": "1"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "@id": "USB_HSPLL_CLK",
          "input": {
            "@signal": "PLL.clk"
          },
          "enable": {
            "@power_modes": "ACTIVE SLEEP",
            "@cond_expr": "(USBPHYConfig != `no`) && (USBPHYConfig != `PFD`)",
            "@description": "Enabled in ACTIVE and SLEEP only"
          }
        }
      ],
      "control_and_constraints": null
    }
  }
}