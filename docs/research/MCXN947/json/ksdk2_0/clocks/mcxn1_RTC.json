{
  "component": {
    "@_xmlns": {
      "clocks": "http://apif.freescale.net/schemas/clocks/1.2",
      "xsi": "http://www.w3.org/2001/XMLSchema-instance"
    },
    "@schemaLocation": "http://apif.freescale.net/schemas/clocks/1.2 http://apif.nxp.com/schemas/clocks/1.2/clocks.xsd",
    "@id": "RTC",
    "instance_header": {
      "instance_description": "Clock model for the RTC module oscillator (parameterized, shared accross all LPC556x parts)"
    },
    "interface": {
      "input_clock_signal": [
        {
          "@id": "CLK16K0_toVBAT",
          "@name": "CLK16K0_toVBAT"
        },
        {
          "@id": "XTAL32K0_toVBAT",
          "@name": "XTAL32K0_toVBAT"
        }
      ],
      "output_clock_signal": {
        "@id": "LP_OSC",
        "@name": "LP_OSC clock"
      }
    },
    "implementation": {
      "clock_select": {
        "@id": "RTCCLKSEL",
        "@name": "RTC clock select",
        "@description": "RTC clock source select ",
        "value_map": {
          "@expr": "RTC0::CTRL[CLK_SEL]",
          "input": [
            {
              "@ctrl_value": "0",
              "@signal": "CLK16K0_toVBAT"
            },
            {
              "@ctrl_value": "1",
              "@signal": "XTAL32K0_toVBAT"
            }
          ]
        },
        "enable": {
          "@power_modes": "ACTIVE SLEEP DEEP_SLEEP"
        }
      },
      "map_output": {
        "@id": "LP_OSC",
        "input": {
          "@signal": "RTCCLKSEL.clk"
        }
      }
    }
  }
}