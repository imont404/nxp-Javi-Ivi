{
  "peripheral": {
    "@_xmlns": {
      "regs": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
      "xsi": "http://www.w3.org/2001/XMLSchema-instance"
    },
    "@schemaLocation": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
    "register": [
      {
        "@offset": "0",
        "@width": "32",
        "@name": "CSR",
        "@description": "Control Status",
        "alias": {
          "@type": "CMSIS",
          "@value": "CSR"
        },
        "bit_field": [
          {
            "@offset": "0",
            "@width": "1",
            "@name": "TEN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Timer Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_CSR_TEN(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_TEN_ten0",
                "@value": "0b0",
                "@description": "Disable"
              },
              {
                "@name": "CSR_TEN_ten1",
                "@value": "0b1",
                "@description": "Enable"
              }
            ]
          },
          {
            "@offset": "1",
            "@width": "1",
            "@name": "TMS",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Timer Mode Select",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_CSR_TMS(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_TMS_tms0",
                "@value": "0b0",
                "@description": "Time Counter"
              },
              {
                "@name": "CSR_TMS_tms1",
                "@value": "0b1",
                "@description": "Pulse Counter"
              }
            ]
          },
          {
            "@offset": "2",
            "@width": "1",
            "@name": "TFC",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Timer Free-Running Counter",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_CSR_TFC(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_TFC_tfc0",
                "@value": "0b0",
                "@description": "Reset when TCF asserts"
              },
              {
                "@name": "CSR_TFC_tfc1",
                "@value": "0b1",
                "@description": "Reset on overflow"
              }
            ]
          },
          {
            "@offset": "3",
            "@width": "1",
            "@name": "TPP",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Timer Pin Polarity",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_CSR_TPP(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_TPP_tpp0",
                "@value": "0b0",
                "@description": "Active-high"
              },
              {
                "@name": "CSR_TPP_tpp1",
                "@value": "0b1",
                "@description": "Active-low"
              }
            ]
          },
          {
            "@offset": "4",
            "@width": "2",
            "@name": "TPS",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Timer Pin Select",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_CSR_TPS(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_TPS_tps00",
                "@value": "0b00",
                "@description": "Input 0"
              },
              {
                "@name": "CSR_TPS_tps01",
                "@value": "0b01",
                "@description": "Input 1"
              },
              {
                "@name": "CSR_TPS_tps10",
                "@value": "0b10",
                "@description": "Input 2"
              },
              {
                "@name": "CSR_TPS_tps11",
                "@value": "0b11",
                "@description": "Input 3"
              }
            ]
          },
          {
            "@offset": "6",
            "@width": "1",
            "@name": "TIE",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Timer Interrupt Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_CSR_TIE(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_TIE_tie0",
                "@value": "0b0",
                "@description": "Disable"
              },
              {
                "@name": "CSR_TIE_tie1",
                "@value": "0b1",
                "@description": "Enable"
              }
            ]
          },
          {
            "@offset": "7",
            "@width": "1",
            "@name": "TCF",
            "@access": "W1C",
            "@reset_value": "0",
            "@description": "Timer Compare Flag",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_CSR_TCF(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_TCF_NO_EFF",
                "@value": "0b0",
                "@description": "No effect"
              },
              {
                "@name": "CSR_TCF_CLEAR_FLAG",
                "@value": "0b1",
                "@description": "Clear the flag"
              }
            ]
          },
          {
            "@offset": "8",
            "@width": "1",
            "@name": "TDRE",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Timer DMA Request Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_CSR_TDRE(x)"
            },
            "bit_field_value": [
              {
                "@name": "CSR_TDRE_trde0",
                "@value": "0b0",
                "@description": "Disable"
              },
              {
                "@name": "CSR_TDRE_trde1",
                "@value": "0b1",
                "@description": "Enable"
              }
            ]
          }
        ],
        "reserved_bit_field": {
          "@offset": "9",
          "@width": "23",
          "@reset_value": "0"
        }
      },
      {
        "@offset": "0x4",
        "@width": "32",
        "@name": "PSR",
        "@description": "Prescaler and Glitch Filter",
        "alias": {
          "@type": "CMSIS",
          "@value": "PSR"
        },
        "bit_field": [
          {
            "@offset": "0",
            "@width": "2",
            "@name": "PCS",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Prescaler and Glitch Filter Clock Select",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_PSR_PCS(x)"
            },
            "bit_field_value": [
              {
                "@name": "PSR_PCS_pcs00",
                "@value": "0b00",
                "@description": "Clock 0"
              },
              {
                "@name": "PSR_PCS_pcs01",
                "@value": "0b01",
                "@description": "Clock 1"
              },
              {
                "@name": "PSR_PCS_pcs10",
                "@value": "0b10",
                "@description": "Clock 2"
              },
              {
                "@name": "PSR_PCS_pcs11",
                "@value": "0b11",
                "@description": "Clock 3"
              }
            ]
          },
          {
            "@offset": "2",
            "@width": "1",
            "@name": "PBYP",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Prescaler and Glitch Filter Bypass",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_PSR_PBYP(x)"
            },
            "bit_field_value": [
              {
                "@name": "PSR_PBYP_pbyp0",
                "@value": "0b0",
                "@description": "Prescaler and glitch filter enable"
              },
              {
                "@name": "PSR_PBYP_pbyp1",
                "@value": "0b1",
                "@description": "Prescaler and glitch filter bypass"
              }
            ]
          },
          {
            "@offset": "3",
            "@width": "4",
            "@name": "PRESCALE",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Prescaler and Glitch Filter Value",
            "alias": {
              "@type": "CMSIS",
              "@value": "LPTMR_PSR_PRESCALE(x)"
            },
            "bit_field_value": [
              {
                "@name": "PSR_PRESCALE_prescale0000",
                "@value": "0b0000",
                "@description": "Prescaler divides the prescaler clock by 2; glitch filter does not support this configuration"
              },
              {
                "@name": "PSR_PRESCALE_prescale0001",
                "@value": "0b0001",
                "@description": "Prescaler divides the prescaler clock by 4; glitch filter recognizes change on input pin after two rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale0010",
                "@value": "0b0010",
                "@description": "Prescaler divides the prescaler clock by 8; glitch filter recognizes change on input pin after four rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale0011",
                "@value": "0b0011",
                "@description": "Prescaler divides the prescaler clock by 16; glitch filter recognizes change on input pin after eight rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale0100",
                "@value": "0b0100",
                "@description": "Prescaler divides the prescaler clock by 32; glitch filter recognizes change on input pin after 16 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale0101",
                "@value": "0b0101",
                "@description": "Prescaler divides the prescaler clock by 64; glitch filter recognizes change on input pin after 32 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale0110",
                "@value": "0b0110",
                "@description": "Prescaler divides the prescaler clock by 128; glitch filter recognizes change on input pin after 64 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale0111",
                "@value": "0b0111",
                "@description": "Prescaler divides the prescaler clock by 256; glitch filter recognizes change on input pin after 128 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale1000",
                "@value": "0b1000",
                "@description": "Prescaler divides the prescaler clock by 512; glitch filter recognizes change on input pin after 256 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale1001",
                "@value": "0b1001",
                "@description": "Prescaler divides the prescaler clock by 1024; glitch filter recognizes change on input pin after 512 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale1010",
                "@value": "0b1010",
                "@description": "Prescaler divides the prescaler clock by 2048; glitch filter recognizes change on input pin after 1024 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale1011",
                "@value": "0b1011",
                "@description": "Prescaler divides the prescaler clock by 4096; glitch filter recognizes change on input pin after 2048 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale1100",
                "@value": "0b1100",
                "@description": "Prescaler divides the prescaler clock by 8192; glitch filter recognizes change on input pin after 4096 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale1101",
                "@value": "0b1101",
                "@description": "Prescaler divides the prescaler clock by 16,384; glitch filter recognizes change on input pin after 8192 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale1110",
                "@value": "0b1110",
                "@description": "Prescaler divides the prescaler clock by 32,768; glitch filter recognizes change on input pin after 16,384 rising clock edges"
              },
              {
                "@name": "PSR_PRESCALE_prescale1111",
                "@value": "0b1111",
                "@description": "Prescaler divides the prescaler clock by 65,536; glitch filter recognizes change on input pin after 32,768 rising clock edges"
              }
            ]
          }
        ],
        "reserved_bit_field": {
          "@offset": "7",
          "@width": "25",
          "@reset_value": "0"
        }
      },
      {
        "@offset": "0x8",
        "@width": "32",
        "@name": "CMR",
        "@description": "Compare",
        "alias": {
          "@type": "CMSIS",
          "@value": "CMR"
        },
        "bit_field": {
          "@offset": "0",
          "@width": "32",
          "@name": "COMPARE",
          "@access": "RW",
          "@reset_value": "0",
          "@description": "Compare Value",
          "alias": {
            "@type": "CMSIS",
            "@value": "LPTMR_CMR_COMPARE(x)"
          }
        }
      },
      {
        "@offset": "0xC",
        "@width": "32",
        "@name": "CNR",
        "@description": "Counter",
        "alias": {
          "@type": "CMSIS",
          "@value": "CNR"
        },
        "bit_field": {
          "@offset": "0",
          "@width": "32",
          "@name": "COUNTER",
          "@access": "RW",
          "@reset_value": "0",
          "@description": "Counter Value",
          "alias": {
            "@type": "CMSIS",
            "@value": "LPTMR_CNR_COUNTER(x)"
          }
        }
      }
    ]
  }
}