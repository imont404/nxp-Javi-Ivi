{
  "peripheral": {
    "@_xmlns": {
      "regs": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
      "xsi": "http://www.w3.org/2001/XMLSchema-instance"
    },
    "@schemaLocation": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
    "register": [
      {
        "@offset": "0xD0",
        "@width": "32",
        "@name": "CTRL",
        "@description": "Security Attribution Unit Control Register",
        "bit_field": [
          {
            "@offset": "0",
            "@width": "1",
            "@name": "ENABLE",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Enable. Enables the SAU. This bit is RAZ/WI when the Security Extension is implemented without an SAU region.",
            "bit_field_value": [
              {
                "@name": "CTRL_ENABLE_DISABLED",
                "@value": "0b0",
                "@description": "The SAU is disabled."
              },
              {
                "@name": "CTRL_ENABLE_ENABLED",
                "@value": "0b1",
                "@description": "The SAU is enabled."
              }
            ]
          },
          {
            "@offset": "1",
            "@width": "1",
            "@name": "ALLNS",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "All Non-secure.",
            "bit_field_value": [
              {
                "@name": "CTRL_ALLNS_SECURED_MEMORY",
                "@value": "0b0",
                "@description": "Memory is marked as Secure and is not Non-secure callable."
              },
              {
                "@name": "CTRL_ALLNS_NON_SECURED_MEMORY",
                "@value": "0b1",
                "@description": "Memory is marked as Non-secure."
              }
            ]
          }
        ],
        "reserved_bit_field": {
          "@offset": "2",
          "@width": "30",
          "@reset_value": "0"
        }
      },
      {
        "@offset": "0xD4",
        "@width": "32",
        "@name": "TYPE",
        "@description": "Security Attribution Unit Type Register",
        "bit_field": {
          "@offset": "0",
          "@width": "8",
          "@name": "SREGION",
          "@access": "RW",
          "@reset_value": "0",
          "@description": "SAU regions. The number of implemented SAU regions."
        },
        "reserved_bit_field": {
          "@offset": "8",
          "@width": "24",
          "@reset_value": "0"
        }
      },
      {
        "@offset": "0xD8",
        "@width": "32",
        "@name": "RNR",
        "@description": "Security Attribution Unit Region Number Register",
        "bit_field": {
          "@offset": "0",
          "@width": "8",
          "@name": "REGION",
          "@access": "RW",
          "@reset_value": "0",
          "@reset_mask": "0",
          "@description": "Region number."
        },
        "reserved_bit_field": {
          "@offset": "8",
          "@width": "24",
          "@reset_value": "0",
          "@reset_mask": "0"
        }
      },
      {
        "@offset": "0xDC",
        "@width": "32",
        "@name": "RBAR",
        "@description": "Security Attribution Unit Region Base Address Register",
        "reserved_bit_field": {
          "@offset": "0",
          "@width": "5",
          "@reset_value": "0",
          "@reset_mask": "0"
        },
        "bit_field": {
          "@offset": "5",
          "@width": "27",
          "@name": "BADDR",
          "@access": "RW",
          "@reset_value": "0",
          "@reset_mask": "0",
          "@description": "Base address. Holds bits[31:5] of the base address for the selected SAU region. Bits[4:0] of the base address are defined as 0x00."
        }
      },
      {
        "@offset": "0xE0",
        "@width": "32",
        "@name": "RLAR",
        "@description": "Security Attribution Unit Region Limit Address Register",
        "bit_field": [
          {
            "@offset": "0",
            "@width": "1",
            "@name": "ENABLE",
            "@access": "RW",
            "@reset_value": "0",
            "@reset_mask": "0",
            "@description": "Enable. SAU region enable.",
            "bit_field_value": [
              {
                "@name": "RLAR_ENABLE_ENABLED",
                "@value": "0b0",
                "@description": "SAU region is enabled."
              },
              {
                "@name": "RLAR_ENABLE_DISABLED",
                "@value": "0b1",
                "@description": "SAU region is disabled."
              }
            ]
          },
          {
            "@offset": "1",
            "@width": "1",
            "@name": "NSC",
            "@access": "RW",
            "@reset_value": "0",
            "@reset_mask": "0",
            "@description": "Non-secure callable. Controls whether Non-secure state is permitted to execute an SG instruction from this region.",
            "bit_field_value": [
              {
                "@name": "RLAR_NSC_NOT_NON_SECURE_CALLABLE",
                "@value": "0b0",
                "@description": "Region is not Non-secure callable."
              },
              {
                "@name": "RLAR_NSC_NON_SECURE_CALLABLE",
                "@value": "0b1",
                "@description": "Region is Non-secure callable."
              }
            ]
          },
          {
            "@offset": "5",
            "@width": "27",
            "@name": "LADDR",
            "@access": "RW",
            "@reset_value": "0",
            "@reset_mask": "0",
            "@description": "Limit address. Holds bits[31:5] of the limit address for the selected SAU region. Bits[4:0] of the limit address are defined as 0x1F."
          }
        ],
        "reserved_bit_field": {
          "@offset": "2",
          "@width": "3",
          "@reset_value": "0",
          "@reset_mask": "0"
        }
      },
      {
        "@offset": "0xE4",
        "@width": "32",
        "@name": "SFSR",
        "@description": "Secure Fault Status Register",
        "bit_field": [
          {
            "@offset": "0",
            "@width": "1",
            "@name": "INVEP",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Invalid entry point.",
            "bit_field_value": [
              {
                "@name": "SFSR_INVEP_NO_ERROR",
                "@value": "0b0",
                "@description": "Error has not occurred."
              },
              {
                "@name": "SFSR_INVEP_ERROR",
                "@value": "0b1",
                "@description": "Error has occurred."
              }
            ]
          },
          {
            "@offset": "1",
            "@width": "1",
            "@name": "INVIS",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Invalid integrity signature flag.",
            "bit_field_value": [
              {
                "@name": "SFSR_INVIS_NO_ERROR",
                "@value": "0b0",
                "@description": "Error has not occurred."
              },
              {
                "@name": "SFSR_INVIS_ERROR",
                "@value": "0b1",
                "@description": "Error has occurred."
              }
            ]
          },
          {
            "@offset": "2",
            "@width": "1",
            "@name": "INVER",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Invalid exception return flag.",
            "bit_field_value": [
              {
                "@name": "SFSR_INVER_NO_ERROR",
                "@value": "0b0",
                "@description": "Error has not occurred."
              },
              {
                "@name": "SFSR_INVER_ERROR",
                "@value": "0b1",
                "@description": "Error has occurred."
              }
            ]
          },
          {
            "@offset": "3",
            "@width": "1",
            "@name": "AUVIOL",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Attribution unit violation flag.",
            "bit_field_value": [
              {
                "@name": "SFSR_AUVIOL_NO_ERROR",
                "@value": "0b0",
                "@description": "Error has not occurred."
              },
              {
                "@name": "SFSR_AUVIOL_ERROR",
                "@value": "0b1",
                "@description": "Error has occurred."
              }
            ]
          },
          {
            "@offset": "4",
            "@width": "1",
            "@name": "INVTRAN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Invalid transition flag.",
            "bit_field_value": [
              {
                "@name": "SFSR_INVTRAN_NO_ERROR",
                "@value": "0b0",
                "@description": "Error has not occurred."
              },
              {
                "@name": "SFSR_INVTRAN_ERROR",
                "@value": "0b1",
                "@description": "Error has occurred."
              }
            ]
          },
          {
            "@offset": "5",
            "@width": "1",
            "@name": "LSPERR",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Lazy state preservation error flag.",
            "bit_field_value": [
              {
                "@name": "SFSR_LSPERR_NO_ERROR",
                "@value": "0b0",
                "@description": "Error has not occurred."
              },
              {
                "@name": "SFSR_LSPERR_ERROR",
                "@value": "0b1",
                "@description": "Error has occurred."
              }
            ]
          },
          {
            "@offset": "6",
            "@width": "1",
            "@name": "SFARVALID",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Secure fault address valid.",
            "bit_field_value": [
              {
                "@name": "SFSR_SFARVALID_NOT_VALID",
                "@value": "0b0",
                "@description": "SFAR content not valid."
              },
              {
                "@name": "SFSR_SFARVALID_VALID",
                "@value": "0b1",
                "@description": "SFAR content valid."
              }
            ]
          },
          {
            "@offset": "7",
            "@width": "1",
            "@name": "LSERR",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Lazy state error flag.",
            "bit_field_value": [
              {
                "@name": "SFSR_LSERR_NO_ERROR",
                "@value": "0b0",
                "@description": "Error has not occurred"
              },
              {
                "@name": "SFSR_LSERR_ERROR",
                "@value": "0b1",
                "@description": "Error has occurred."
              }
            ]
          }
        ],
        "reserved_bit_field": {
          "@offset": "8",
          "@width": "24",
          "@reset_value": "0"
        }
      },
      {
        "@offset": "0xE8",
        "@width": "32",
        "@name": "SFAR",
        "@description": "Secure Fault Address Register",
        "bit_field": {
          "@offset": "0",
          "@width": "32",
          "@name": "ADDRESS",
          "@access": "RW",
          "@reset_value": "0",
          "@reset_mask": "0",
          "@description": "When the SFARVALID bit of the SFSR is set to 1, this field holds the address of an access that caused an SAU violation."
        }
      }
    ]
  }
}