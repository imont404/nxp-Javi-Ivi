    "reg_instance": [
      {
        "@rid": "0",
        "@vals": "0 0"
      },
      {
        "@rid": "4",
        "@vals": "0x4 0"
      },
      {
        "@rid": "8",
        "@vals": "0x8 0"
      },
      {
        "@rid": "12",
        "@vals": "0xC 0"
      },
      {
        "@rid": "0",
        "@vals": "0x10 1"
      },
