              "@value": "MRT_IRQ_FLAG_GFLAG0(x)"
            },
            "bit_field_value": [
              {
                "@name": "IRQ_FLAG_GFLAG0_NO_PENDING_INTERRUPT",
                "@value": "0b0",
                "@description": "No pending interrupt."
              },
              {
                "@name": "IRQ_FLAG_GFLAG0_PENDING_INTERRUPT",
                "@value": "0b1",
                "@description": "Pending interrupt"
              }
            ]
          },
          {
            "@offset": "1",
            "@width": "1",
            "@name": "GFLAG1",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Interrupt Flag",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_IRQ_FLAG_GFLAG1(x)"
            }
          },
          {
            "@offset": "2",
            "@width": "1",
            "@name": "GFLAG2",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Interrupt Flag",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_IRQ_FLAG_GFLAG2(x)"
            }
          },
          {
            "@offset": "3",
            "@width": "1",
            "@name": "GFLAG3",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Interrupt Flag",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_IRQ_FLAG_GFLAG3(x)"
            }
          }
