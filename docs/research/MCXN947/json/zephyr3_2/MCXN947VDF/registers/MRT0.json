{
  "peripheral": {
    "@_xmlns": {
      "regs": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
      "xsi": "http://www.w3.org/2001/XMLSchema-instance"
    },
    "@schemaLocation": "http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd",
    "reg_template": [
      {
        "@rid": "0",
        "@offset": "{0}",
        "@width": "32",
        "@name": "INTVAL{1}",
        "@description": "Time Interval Value",
        "alias": {
          "@type": "CMSIS",
          "@value": "CHANNEL[{1}].INTVAL"
        },
        "bit_field": [
          {
            "@offset": "0",
            "@width": "24",
            "@name": "IVALUE",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Time Interval Load Value.",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_CHANNEL_INTVAL_IVALUE(x)"
            }
          },
          {
            "@offset": "31",
            "@width": "1",
            "@name": "LOAD",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Force Load Enable",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_CHANNEL_INTVAL_LOAD(x)"
            },
            "bit_field_value": [
              {
                "@name": "INTVAL{1}_LOAD_NO_FORCE_LOAD",
                "@value": "0b0",
                "@description": "No force load"
              },
              {
                "@name": "INTVAL{1}_LOAD_FORCE_LOAD",
                "@value": "0b1",
                "@description": "Force load"
              }
            ]
          }
        ],
        "reserved_bit_field": {
          "@offset": "24",
          "@width": "7",
          "@reset_value": "0",
          "@reset_mask": "0"
        }
      },
      {
        "@rid": "4",
        "@offset": "{0}",
        "@width": "32",
        "@name": "TIMER{1}",
        "@description": "Timer",
        "alias": {
          "@type": "CMSIS",
          "@value": "CHANNEL[{1}].TIMER"
        },
        "bit_field": {
          "@offset": "0",
          "@width": "24",
          "@name": "VALUE",
          "@access": "RO",
          "@reset_value": "0xFFFFFF",
          "@description": "Current Timer Value",
          "alias": {
            "@type": "CMSIS",
            "@value": "MRT_CHANNEL_TIMER_VALUE(x)"
          }
        },
        "reserved_bit_field": {
          "@offset": "24",
          "@width": "8",
          "@reset_value": "0",
          "@reset_mask": "0"
        }
      },
      {
        "@rid": "8",
        "@offset": "{0}",
        "@width": "32",
        "@name": "CTRL{1}",
        "@description": "Control",
        "alias": {
          "@type": "CMSIS",
          "@value": "CHANNEL[{1}].CTRL"
        },
        "bit_field": [
          {
            "@offset": "0",
            "@width": "1",
            "@name": "INTEN",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Interrupt request",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_CHANNEL_CTRL_INTEN(x)"
            },
            "bit_field_value": [
              {
                "@name": "CTRL{1}_INTEN_DISABLED",
                "@value": "0b0",
                "@description": "Disabled"
              },
              {
                "@name": "CTRL{1}_INTEN_ENABLED",
                "@value": "0b1",
                "@description": "Enabled"
              }
            ]
          },
          {
            "@offset": "1",
            "@width": "2",
            "@name": "MODE",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "MRT Operating mode",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_CHANNEL_CTRL_MODE(x)"
            },
            "bit_field_value": [
              {
                "@name": "CTRL{1}_MODE_REPEAT_INTERRUPT_MODE",
                "@value": "0b00",
                "@description": "Repeat Interrupt mode"
              },
              {
                "@name": "CTRL{1}_MODE_ONE_SHOT_INTERRUPT_MODE",
                "@value": "0b01",
                "@description": "One-Shot Interrupt mode"
              },
              {
                "@name": "CTRL{1}_MODE_ONE_SHOT_STALL_MODE",
                "@value": "0b10",
                "@description": "One-Shot Stall mode"
              },
              {
                "@name": "CTRL{1}_MODE_RESERVED",
                "@value": "0b11",
                "@description": "Reserved"
              }
            ]
          }
        ],
        "reserved_bit_field": {
          "@offset": "3",
          "@width": "29",
          "@reset_value": "0",
          "@reset_mask": "0"
        }
      },
      {
        "@rid": "12",
        "@offset": "{0}",
        "@width": "32",
        "@name": "STAT{1}",
        "@description": "Status",
        "alias": {
          "@type": "CMSIS",
          "@value": "CHANNEL[{1}].STAT"
        },
        "bit_field": [
          {
            "@offset": "0",
            "@width": "1",
            "@name": "INTFLAG",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "Interrupt Flag",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_CHANNEL_STAT_INTFLAG(x)"
            },
            "bit_field_value": [
              {
                "@name": "STAT{1}_INTFLAG_NO_PENDING_INTERRUPT",
                "@value": "0b0",
                "@description": "No pending interrupt."
              },
              {
                "@name": "STAT{1}_INTFLAG_PENDING_INTERRUPT",
                "@value": "0b1",
                "@description": "Pending interrupt."
              }
            ]
          },
          {
            "@offset": "1",
            "@width": "1",
            "@name": "RUN",
            "@access": "RO",
            "@reset_value": "0",
            "@description": "Timer n State",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_CHANNEL_STAT_RUN(x)"
            },
            "bit_field_value": [
              {
                "@name": "STAT{1}_RUN_IDLE_STATE",
                "@value": "0b0",
                "@description": "Idle state."
              },
              {
                "@name": "STAT{1}_RUN_RUNNING",
                "@value": "0b1",
                "@description": "Running."
              }
            ]
          },
          {
            "@offset": "2",
            "@width": "1",
            "@name": "INUSE",
            "@access": "W1C",
            "@reset_value": "0",
            "@description": "Channel-In-Use flag",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_CHANNEL_STAT_INUSE(x)"
            },
            "bit_field_value": [
              {
                "@name": "STAT{1}_INUSE_NO",
                "@value": "0b0",
                "@description": "This timer channel is not in use."
              },
              {
                "@name": "STAT{1}_INUSE_YES",
                "@value": "0b1",
                "@description": "This timer channel is in use."
              }
            ]
          }
        ],
        "reserved_bit_field": {
          "@offset": "3",
          "@width": "29",
          "@reset_value": "0",
          "@reset_mask": "0"
        }
      }
