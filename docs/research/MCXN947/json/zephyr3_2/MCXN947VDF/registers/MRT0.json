        "bit_field": [
          {
            "@offset": "0",
            "@width": "4",
            "@name": "NOC",
            "@access": "RW",
            "@reset_value": "0x4",
            "@description": "Number of Channels",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_MODCFG_NOC(x)"
            }
          },
          {
            "@offset": "4",
            "@width": "5",
            "@name": "NOB",
            "@access": "RW",
            "@reset_value": "0x18",
            "@description": "Number of Bits",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_MODCFG_NOB(x)"
            }
          },
          {
            "@offset": "31",
            "@width": "1",
            "@name": "MULTITASK",
            "@access": "RW",
            "@reset_value": "0",
            "@description": "MULTITASK",
            "alias": {
              "@type": "CMSIS",
              "@value": "MRT_MODCFG_MULTITASK(x)"
            },
            "bit_field_value": [
              {
                "@name": "MODCFG_MULTITASK_HARDWARE_STATUS_MODE",
                "@value": "0b0",
                "@description": "Hardware status mode."
              },
              {
                "@name": "MODCFG_MULTITASK_MULTI_TASK_MODE",
                "@value": "0b1",
                "@description": "Multitask mode"
              }
            ]
          }
        ],
        "reserved_bit_field": {
          "@offset": "9",
          "@width": "22",
          "@reset_value": "0",
          "@reset_mask": "0"
        }
      },
      {
