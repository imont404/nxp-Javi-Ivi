        "@rid": "0",
        "@vals": "0x20 2"
      },
      {
        "@rid": "4",
        "@vals": "0x24 2"
      },
      {
        "@rid": "8",
        "@vals": "0x28 2"
      },
      {
        "@rid": "12",
        "@vals": "0x2C 2"
