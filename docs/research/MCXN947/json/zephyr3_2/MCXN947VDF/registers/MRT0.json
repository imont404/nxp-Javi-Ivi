        "@width": "32",
        "@name": "IDLE_CH",
        "@description": "Idle Channel",
        "alias": {
          "@type": "CMSIS",
          "@value": "IDLE_CH"
        },
        "reserved_bit_field": [
          {
            "@offset": "0",
            "@width": "4",
            "@reset_value": "0",
            "@reset_mask": "0"
          },
          {
            "@offset": "8",
            "@width": "24",
            "@reset_value": "0",
            "@reset_mask": "0"
          }
        ],
        "bit_field": {
          "@offset": "4",
          "@width": "4",
          "@name": "CHAN",
          "@access": "RO",
          "@reset_value": "0",
          "@description": "Idle Channel",
          "alias": {
            "@type": "CMSIS",
            "@value": "MRT_IDLE_CH_CHAN(x)"
          }
        }
      },
      {
        "@offset": "0xF8",
        "@width": "32",
        "@name": "IRQ_FLAG",
