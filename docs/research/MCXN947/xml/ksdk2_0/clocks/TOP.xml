    <implementation>
      <configuration_element id="PLL0_Mode" name="PLL0 Mode" description="PLL0 mode select. This setting provide configuration of the APLL and APLL_BYPASS clock selector.">
        <default value="Power_down"/>
        <item id="Fractional" description="Fractional">
          <long_description>
			  The PLL runs in a fractional divide. The fractional mode uses an integer divide value and that value plus 1 in a ratio determined by the fractional part of the divide value in order to obtain an average rate that is a fractional multiple of the PLL reference frequency. 			
             </long_description>
          <assigns>
            <assign register="SCG0::APLLCSR" bit_field="APLLPWREN" value="1"/>
            <assign register="SCG0::APLLCSR" bit_field="APLLCLKEN" value="1"/>
            <assign register="SCG0::APLLCSR" bit_field="APLLSTEN" value="1"/>
            <assign register="SCG0::APLLCTRL" bit_field="LIMUPOFF" value="1"/>
            <assign register="SCG0::APLLSSCG1" bit_field="SS_PD" value="0"/>
            <assign register="SCG0::APLLSSCG1" bit_field="SEL_SS_MDIV" value="1"/>
            <assign register="SCG0::APLLSSCG1" bit_field="MR" value="0"/>
          </assigns>
          <constraint cond_expr="SCG0::APLLSSCG1[MR] == 0" description="No spread spectrum in Fractional mode."/>
        </item>
        <item id="Spread_spectrum_normal" description="Spread spectrum normal">
          <long_description>
              The spread spectrum functionality can be used to modulate the PLL output frequency automatically, in a programmable manner. This can decrease electromagnetic interference (EMI) in an application.
			  Spread spectrum mode is enabled by the modulation of the PLL output signal (disabled in fractional mode). See the Frequency modulation depth of the PLL settings.
			 </long_description>
          <assigns>
            <assign register="SCG0::APLLCSR" bit_field="APLLPWREN" value="1"/>
            <assign register="SCG0::APLLCSR" bit_field="APLLCLKEN" value="1"/>
            <assign register="SCG0::APLLCSR" bit_field="APLLSTEN" value="1"/>
            <assign register="SCG0::APLLCTRL" bit_field="LIMUPOFF" value="1"/>
            <assign register="SCG0::APLLSSCG1" bit_field="SS_PD" value="0"/>
            <assign register="SCG0::APLLSSCG1" bit_field="SEL_SS_MDIV" value="0"/>
            <assign when="SCG0::APLLSSCG1[MR] == 0" register="SCG0::APLLSSCG1" bit_field="MR" value="1"/>
          </assigns>
          <constraint cond_expr="SCG0::APLLSSCG1[MR] != 0" description="Spread spectrum mode must be enabled by selection of the PLL0 Frequency modulation depth greater than zero (APLLSSCG1[MR] &gt; 0)."/>
        </item>
        <item id="Spread_spectrum_fractional" description="Spread spectrum fractional">
          <long_description>
              The spread spectrum functionality can be used to modulate the PLL output frequency automatically, in a programmable manner. This can decrease electromagnetic interference (EMI) in an application.
			  Spread spectrum mode is enabled by the modulation of the PLL output signal (disabled in fractional mode). See the Frequency modulation depth of the PLL settings.
			 </long_description>
          <assigns>
            <assign register="SCG0::APLLCSR" bit_field="APLLPWREN" value="1"/>
            <assign register="SCG0::APLLCSR" bit_field="APLLCLKEN" value="1"/>
            <assign register="SCG0::APLLCSR" bit_field="APLLSTEN" value="1"/>
            <assign register="SCG0::APLLCTRL" bit_field="LIMUPOFF" value="1"/>
            <assign register="SCG0::APLLSSCG1" bit_field="SS_PD" value="0"/>
            <assign register="SCG0::APLLSSCG1" bit_field="SEL_SS_MDIV" value="1"/>
            <assign when="SCG0::APLLSSCG1[MR] == 0" register="SCG0::APLLSSCG1" bit_field="MR" value="1"/>
          </assigns>
          <constraint cond_expr="SCG0::APLLSSCG1[MR] != 0" description="Spread spectrum mode must be enabled by selection of the PLL0 Frequency modulation depth greater than zero (APLLSSCG1[MR] &gt; 0)."/>
        </item>
        <item id="Normal" description="Normal">
          <long_description>
			  Typical operation of the PLL includes an optional pre-divide of the PLL input, followed by a frequency multiplication, and finally an optional post-divide to produce the PLL output.
			</long_description>
          <assigns>
            <assign register="SCG0::APLLCSR" bit_field="APLLPWREN" value="1"/>
            <assign register="SCG0::APLLCSR" bit_field="APLLCLKEN" value="1"/>
            <assign register="SCG0::APLLCSR" bit_field="APLLSTEN" value="1"/>
            <assign register="SCG0::APLLCTRL" bit_field="LIMUPOFF" value="0"/>
            <assign register="SCG0::APLLSSCG1" bit_field="SS_PD" value="1"/>
            <assign register="SCG0::APLLSSCG1" bit_field="SEL_SS_MDIV" value="0"/>
            <assign register="SCG0::APLLSSCG1" bit_field="MR" value="0"/>
          </assigns>
        </item>
        <item id="Power_down" description="Power_down">
          <long_description>
			  If the PLL is not used, or if it there are cases where it is turned off in a running application, power can be saved by putting the PLL in power-down mode. Before this is done, the CPU and any peripherals that are not meant to stopped as well must be running from some other clock source.
			</long_description>
          <assigns>
            <assign register="SCG0::APLLCSR" bit_field="APLLPWREN" value="0"/>
            <assign register="SCG0::APLLCSR" bit_field="APLLCLKEN" value="0"/>
            <assign register="SCG0::APLLSSCG1" bit_field="SS_PD" value="1"/>
          </assigns>
        </item>
      </configuration_element>
