      <configuration_element id="RunPowerMode" name="DCDC and LDO_CORE Voltage" description="DCDC VDD and LDO_CORE VDD regulator voltage level">
        <default value="MD"/>
        <item id="OD" description="OD(1.2 V)">
          <long_description>over drive mode.</long_description>
          <assigns>
            <assign register="SPC0::ACTIVE_CFG" bit_field="DCDC_VDD_LVL" value="3"/>
            <assign register="SPC0::ACTIVE_CFG" bit_field="CORELDO_VDD_LVL" value="3"/>
            <assign register="SPC0::SRAMCTL" bit_field="VSM" value="3"/>
          </assigns>
        </item>
        <item id="SD" description="SD(1.1 V)">
          <long_description>standard drive mode.</long_description>
          <assigns>
            <assign register="SPC0::ACTIVE_CFG" bit_field="DCDC_VDD_LVL" value="2"/>
            <assign register="SPC0::ACTIVE_CFG" bit_field="CORELDO_VDD_LVL" value="2"/>
            <assign register="SPC0::SRAMCTL" bit_field="VSM" value="2"/>
          </assigns>
        </item>
        <item id="MD" description="MD(1.0 V)">
