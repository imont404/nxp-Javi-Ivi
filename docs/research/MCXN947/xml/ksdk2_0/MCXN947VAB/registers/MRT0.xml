<?xml version="1.0"?>
<regs:peripheral xmlns:regs="http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd">
  <reg_template rid="0" offset="{0}" width="32" name="INTVAL{1}" description="Time Interval Value">
    <alias type="CMSIS" value="CHANNEL[{1}].INTVAL"/>
    <bit_field offset="0" width="24" name="IVALUE" access="RW" reset_value="0" description="Time Interval Load Value.">
      <alias type="CMSIS" value="MRT_CHANNEL_INTVAL_IVALUE(x)"/>
    </bit_field>
    <reserved_bit_field offset="24" width="7" reset_value="0" reset_mask="0"/>
    <bit_field offset="31" width="1" name="LOAD" access="RW" reset_value="0" description="Force Load Enable">
      <alias type="CMSIS" value="MRT_CHANNEL_INTVAL_LOAD(x)"/>
      <bit_field_value name="INTVAL{1}_LOAD_NO_FORCE_LOAD" value="0b0" description="No force load"/>
      <bit_field_value name="INTVAL{1}_LOAD_FORCE_LOAD" value="0b1" description="Force load"/>
    </bit_field>
  </reg_template>
  <reg_template rid="4" offset="{0}" width="32" name="TIMER{1}" description="Timer">
    <alias type="CMSIS" value="CHANNEL[{1}].TIMER"/>
    <bit_field offset="0" width="24" name="VALUE" access="RO" reset_value="0xFFFFFF" description="Current Timer Value">
      <alias type="CMSIS" value="MRT_CHANNEL_TIMER_VALUE(x)"/>
    </bit_field>
    <reserved_bit_field offset="24" width="8" reset_value="0" reset_mask="0"/>
  </reg_template>
  <reg_template rid="8" offset="{0}" width="32" name="CTRL{1}" description="Control">
    <alias type="CMSIS" value="CHANNEL[{1}].CTRL"/>
    <bit_field offset="0" width="1" name="INTEN" access="RW" reset_value="0" description="Interrupt request">
      <alias type="CMSIS" value="MRT_CHANNEL_CTRL_INTEN(x)"/>
      <bit_field_value name="CTRL{1}_INTEN_DISABLED" value="0b0" description="Disabled"/>
      <bit_field_value name="CTRL{1}_INTEN_ENABLED" value="0b1" description="Enabled"/>
    </bit_field>
    <bit_field offset="1" width="2" name="MODE" access="RW" reset_value="0" description="MRT Operating mode">
      <alias type="CMSIS" value="MRT_CHANNEL_CTRL_MODE(x)"/>
      <bit_field_value name="CTRL{1}_MODE_REPEAT_INTERRUPT_MODE" value="0b00" description="Repeat Interrupt mode"/>
      <bit_field_value name="CTRL{1}_MODE_ONE_SHOT_INTERRUPT_MODE" value="0b01" description="One-Shot Interrupt mode"/>
      <bit_field_value name="CTRL{1}_MODE_ONE_SHOT_STALL_MODE" value="0b10" description="One-Shot Stall mode"/>
      <bit_field_value name="CTRL{1}_MODE_RESERVED" value="0b11" description="Reserved"/>
    </bit_field>
    <reserved_bit_field offset="3" width="29" reset_value="0" reset_mask="0"/>
  </reg_template>
  <reg_template rid="12" offset="{0}" width="32" name="STAT{1}" description="Status">
    <alias type="CMSIS" value="CHANNEL[{1}].STAT"/>
    <bit_field offset="0" width="1" name="INTFLAG" access="RW" reset_value="0" description="Interrupt Flag">
      <alias type="CMSIS" value="MRT_CHANNEL_STAT_INTFLAG(x)"/>
      <bit_field_value name="STAT{1}_INTFLAG_NO_PENDING_INTERRUPT" value="0b0" description="No pending interrupt."/>
      <bit_field_value name="STAT{1}_INTFLAG_PENDING_INTERRUPT" value="0b1" description="Pending interrupt."/>
    </bit_field>
    <bit_field offset="1" width="1" name="RUN" access="RO" reset_value="0" description="Timer n State">
      <alias type="CMSIS" value="MRT_CHANNEL_STAT_RUN(x)"/>
      <bit_field_value name="STAT{1}_RUN_IDLE_STATE" value="0b0" description="Idle state."/>
      <bit_field_value name="STAT{1}_RUN_RUNNING" value="0b1" description="Running."/>
    </bit_field>
    <bit_field offset="2" width="1" name="INUSE" access="W1C" reset_value="0" description="Channel-In-Use flag">
      <alias type="CMSIS" value="MRT_CHANNEL_STAT_INUSE(x)"/>
      <bit_field_value name="STAT{1}_INUSE_NO" value="0b0" description="This timer channel is not in use."/>
      <bit_field_value name="STAT{1}_INUSE_YES" value="0b1" description="This timer channel is in use."/>
    </bit_field>
    <reserved_bit_field offset="3" width="29" reset_value="0" reset_mask="0"/>
  </reg_template>
  <reg_instance rid="0" vals="0 0"/>
  <reg_instance rid="4" vals="0x4 0"/>
  <reg_instance rid="8" vals="0x8 0"/>
  <reg_instance rid="12" vals="0xC 0"/>
  <reg_instance rid="0" vals="0x10 1"/>
  <reg_instance rid="4" vals="0x14 1"/>
  <reg_instance rid="8" vals="0x18 1"/>
  <reg_instance rid="12" vals="0x1C 1"/>
  <reg_instance rid="0" vals="0x20 2"/>
  <reg_instance rid="4" vals="0x24 2"/>
  <reg_instance rid="8" vals="0x28 2"/>
  <reg_instance rid="12" vals="0x2C 2"/>
  <reg_instance rid="0" vals="0x30 3"/>
  <reg_instance rid="4" vals="0x34 3"/>
  <reg_instance rid="8" vals="0x38 3"/>
  <reg_instance rid="12" vals="0x3C 3"/>
  <register offset="0xF0" width="32" name="MODCFG" description="Module Configuration">
    <alias type="CMSIS" value="MODCFG"/>
    <bit_field offset="0" width="4" name="NOC" access="RW" reset_value="0x4" description="Number of Channels">
      <alias type="CMSIS" value="MRT_MODCFG_NOC(x)"/>
    </bit_field>
    <bit_field offset="4" width="5" name="NOB" access="RW" reset_value="0x18" description="Number of Bits">
      <alias type="CMSIS" value="MRT_MODCFG_NOB(x)"/>
    </bit_field>
    <reserved_bit_field offset="9" width="22" reset_value="0" reset_mask="0"/>
    <bit_field offset="31" width="1" name="MULTITASK" access="RW" reset_value="0" description="MULTITASK">
      <alias type="CMSIS" value="MRT_MODCFG_MULTITASK(x)"/>
      <bit_field_value name="MODCFG_MULTITASK_HARDWARE_STATUS_MODE" value="0b0" description="Hardware status mode."/>
      <bit_field_value name="MODCFG_MULTITASK_MULTI_TASK_MODE" value="0b1" description="Multitask mode"/>
    </bit_field>
  </register>
  <register offset="0xF4" width="32" name="IDLE_CH" description="Idle Channel">
    <alias type="CMSIS" value="IDLE_CH"/>
    <reserved_bit_field offset="0" width="4" reset_value="0" reset_mask="0"/>
    <bit_field offset="4" width="4" name="CHAN" access="RO" reset_value="0" description="Idle Channel">
      <alias type="CMSIS" value="MRT_IDLE_CH_CHAN(x)"/>
    </bit_field>
    <reserved_bit_field offset="8" width="24" reset_value="0" reset_mask="0"/>
  </register>
  <register offset="0xF8" width="32" name="IRQ_FLAG" description="Global Interrupt Flag">
    <alias type="CMSIS" value="IRQ_FLAG"/>
    <bit_field offset="0" width="1" name="GFLAG0" access="RW" reset_value="0" description="Interrupt Flag">
      <alias type="CMSIS" value="MRT_IRQ_FLAG_GFLAG0(x)"/>
      <bit_field_value name="IRQ_FLAG_GFLAG0_NO_PENDING_INTERRUPT" value="0b0" description="No pending interrupt."/>
      <bit_field_value name="IRQ_FLAG_GFLAG0_PENDING_INTERRUPT" value="0b1" description="Pending interrupt"/>
    </bit_field>
    <bit_field offset="1" width="1" name="GFLAG1" access="RW" reset_value="0" description="Interrupt Flag">
      <alias type="CMSIS" value="MRT_IRQ_FLAG_GFLAG1(x)"/>
    </bit_field>
    <bit_field offset="2" width="1" name="GFLAG2" access="RW" reset_value="0" description="Interrupt Flag">
      <alias type="CMSIS" value="MRT_IRQ_FLAG_GFLAG2(x)"/>
    </bit_field>
    <bit_field offset="3" width="1" name="GFLAG3" access="RW" reset_value="0" description="Interrupt Flag">
      <alias type="CMSIS" value="MRT_IRQ_FLAG_GFLAG3(x)"/>
    </bit_field>
    <reserved_bit_field offset="4" width="28" reset_value="0" reset_mask="0"/>
  </register>
</regs:peripheral>