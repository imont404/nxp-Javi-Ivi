<?xml version="1.0"?>
<regs:peripheral xmlns:regs="http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd">
  <register offset="0" width="32" name="DATA" description="Data">
    <alias type="CMSIS" value="DATA"/>
    <bit_field offset="0" width="8" name="LL" access="RW" reset_value="0xFF" description="Lower Part of Low Byte">
      <alias type="CMSIS" value="CRC_DATA_LL(x)"/>
    </bit_field>
    <bit_field offset="8" width="8" name="LU" access="RW" reset_value="0xFF" description="Upper Part of Low Byte">
      <alias type="CMSIS" value="CRC_DATA_LU(x)"/>
    </bit_field>
    <bit_field offset="16" width="8" name="HL" access="RW" reset_value="0xFF" description="Lower Part of High Byte">
      <alias type="CMSIS" value="CRC_DATA_HL(x)"/>
    </bit_field>
    <bit_field offset="24" width="8" name="HU" access="RW" reset_value="0xFF" description="Upper Part of High Byte">
      <alias type="CMSIS" value="CRC_DATA_HU(x)"/>
    </bit_field>
  </register>
  <register offset="0x4" width="32" name="GPOLY" description="Polynomial">
    <alias type="CMSIS" value="GPOLY"/>
    <bit_field offset="0" width="16" name="LOW" access="RW" reset_value="0x1021" description="Low Half-Word">
      <alias type="CMSIS" value="CRC_GPOLY_LOW(x)"/>
    </bit_field>
    <bit_field offset="16" width="16" name="HIGH" access="RW" reset_value="0" description="High Half-Word">
      <alias type="CMSIS" value="CRC_GPOLY_HIGH(x)"/>
    </bit_field>
  </register>
  <register offset="0x8" width="32" name="CTRL" description="Control">
    <alias type="CMSIS" value="CTRL"/>
    <reserved_bit_field offset="0" width="24" reset_value="0"/>
    <bit_field offset="24" width="1" name="TCRC" access="RW" reset_value="0" description="TCRC">
      <alias type="CMSIS" value="CRC_CTRL_TCRC(x)"/>
      <bit_field_value name="CTRL_TCRC_B16" value="0b0" description="16 bits"/>
      <bit_field_value name="CTRL_TCRC_B32" value="0b1" description="32 bits"/>
    </bit_field>
    <bit_field offset="25" width="1" name="WAS" access="RW" reset_value="0" description="Write as Seed">
      <alias type="CMSIS" value="CRC_CTRL_WAS(x)"/>
      <bit_field_value name="CTRL_WAS_DATA" value="0b0" description="Data values"/>
      <bit_field_value name="CTRL_WAS_SEED" value="0b1" description="Seed values"/>
    </bit_field>
    <bit_field offset="26" width="1" name="FXOR" access="RW" reset_value="0" description="Complement Read of CRC Data Register">
      <alias type="CMSIS" value="CRC_CTRL_FXOR(x)"/>
      <bit_field_value name="CTRL_FXOR_NOXOR" value="0b0" description="Disables XOR on reading data."/>
      <bit_field_value name="CTRL_FXOR_INVERT" value="0b1" description="Inverts or complements the read value of the CRC Data."/>
    </bit_field>
    <reserved_bit_field offset="27" width="1" reset_value="0"/>
    <bit_field offset="28" width="2" name="TOTR" access="RW" reset_value="0" description="Transpose Type for Read">
      <alias type="CMSIS" value="CRC_CTRL_TOTR(x)"/>
      <bit_field_value name="CTRL_TOTR_NOTRNPS" value="0b00" description="No transposition"/>
      <bit_field_value name="CTRL_TOTR_BTS_TRNPS" value="0b01" description="Bits in bytes are transposed, but bytes are not transposed."/>
      <bit_field_value name="CTRL_TOTR_BYTS_BTS_TRNPS" value="0b10" description="Both bits in bytes and bytes are transposed."/>
      <bit_field_value name="CTRL_TOTR_BYTS_TRNPS" value="0b11" description="Only bytes are transposed, no bits in a byte are transposed."/>
    </bit_field>
    <bit_field offset="30" width="2" name="TOT" access="RW" reset_value="0" description="Transpose Type for Write">
      <alias type="CMSIS" value="CRC_CTRL_TOT(x)"/>
      <bit_field_value name="CTRL_TOT_NOTRNPS" value="0b00" description="No transposition"/>
      <bit_field_value name="CTRL_TOT_BTS_TRNPS" value="0b01" description="Bits in bytes are transposed, but bytes are not transposed."/>
      <bit_field_value name="CTRL_TOT_BYTS_BTS_TRNPS" value="0b10" description="Both bits in bytes and bytes are transposed."/>
      <bit_field_value name="CTRL_TOT_BYTS_TRNPS" value="0b11" description="Only bytes are transposed, no bits in a byte are transposed."/>
    </bit_field>
  </register>
</regs:peripheral>