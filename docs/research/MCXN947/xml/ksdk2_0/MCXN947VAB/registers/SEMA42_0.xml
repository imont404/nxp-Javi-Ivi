      <bit_field_value name="GATE{1}_GTFSM_LOCKED_BY_D11" value="0b1100" description="Domain 11 locked the gate."/>
      <bit_field_value name="GATE{1}_GTFSM_LOCKED_BY_D12" value="0b1101" description="Domain 12 locked the gate."/>
      <bit_field_value name="GATE{1}_GTFSM_LOCKED_BY_D13" value="0b1110" description="Domain 13 locked the gate."/>
      <bit_field_value name="GATE{1}_GTFSM_LOCKED_BY_D14" value="0b1111" description="Domain 14 locked the gate."/>
    </bit_field>
    <reserved_bit_field offset="4" width="4" reset_value="0"/>
