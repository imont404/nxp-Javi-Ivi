      <bit_field_value name="GATE{1}_GTFSM_UNLOCKED" value="0b0000" description="The gate is unlocked (free)."/>
      <bit_field_value name="GATE{1}_GTFSM_LOCKED_BY_D0" value="0b0001" description="Domain 0 locked the gate."/>
