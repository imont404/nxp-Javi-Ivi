  <register offset="0x42" width="16" name="RSTGT_R" description="Reset Gate Read">
    <alias type="CMSIS" value="RSTGT_R"/>
    <bit_field offset="0" width="8" name="RSTGTN" access="RO" reset_value="0" description="Reset Gate Number">
      <alias type="CMSIS" value="SEMA42_RSTGT_R_RSTGTN(x)"/>
    </bit_field>
    <bit_field offset="8" width="4" name="RSTGMS" access="RO" reset_value="0" description="Reset Gate Domain">
      <alias type="CMSIS" value="SEMA42_RSTGT_R_RSTGMS(x)"/>
    </bit_field>
    <bit_field offset="12" width="2" name="RSTGSM" access="RO" reset_value="0" description="Reset Gate Finite State Machine">
      <alias type="CMSIS" value="SEMA42_RSTGT_R_RSTGSM(x)"/>
      <bit_field_value name="RSTGT_R_RSTGSM_IDLE" value="0b00" description="Idle, waiting for the first data pattern write."/>
      <bit_field_value name="RSTGT_R_RSTGSM_WAITING" value="0b01" description="Waiting for the second data pattern write"/>
      <bit_field_value name="RSTGT_R_RSTGSM_TWO_WRITE_DONE" value="0b10" description="The 2-write sequence has completed. Generate the specified gate reset(s). After the reset is performed, this machine returns to the idle (waiting for first data pattern write) state."/>
