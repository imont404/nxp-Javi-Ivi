<?xml version="1.0"?>
<regs:peripheral xmlns:regs="http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd http://swtools.freescale.net/XSD/registers/6.0/regsPeripheral.xsd">
  <register offset="0" width="32" name="VERID" description="Version ID">
    <alias type="CMSIS" value="VERID"/>
    <bit_field offset="0" width="16" name="FEATURE" access="RO" reset_value="0" description="Feature Specification Number">
      <alias type="CMSIS" value="OPAMP_VERID_FEATURE(x)"/>
    </bit_field>
    <bit_field offset="16" width="8" name="MINOR" access="RO" reset_value="0" description="Minor Version Number">
      <alias type="CMSIS" value="OPAMP_VERID_MINOR(x)"/>
    </bit_field>
    <bit_field offset="24" width="8" name="MAJOR" access="RO" reset_value="0" description="Major Version Number">
      <alias type="CMSIS" value="OPAMP_VERID_MAJOR(x)"/>
    </bit_field>
  </register>
  <register offset="0x4" width="32" name="PARAM" description="Parameter">
    <alias type="CMSIS" value="PARAM"/>
    <bit_field offset="0" width="1" name="PGA_FUNCTION" access="RO" reset_value="0x1" description="PGA Function Option">
      <alias type="CMSIS" value="OPAMP_PARAM_PGA_FUNCTION(x)"/>
      <bit_field_value name="PARAM_PGA_FUNCTION_CORE_AMP" value="0b0" description="Core amplifier enabled"/>
      <bit_field_value name="PARAM_PGA_FUNCTION_PGA" value="0b1" description="PGA function enabled"/>
    </bit_field>
    <reserved_bit_field offset="1" width="31" reset_value="0"/>
  </register>
  <register offset="0x8" width="32" name="OPAMP_CTR" description="OPAMP Control">
    <alias type="CMSIS" value="OPAMP_CTR"/>
    <bit_field offset="0" width="1" name="EN" access="RW" reset_value="0" description="OPAMP Enable">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_EN(x)"/>
      <bit_field_value name="OPAMP_CTR_EN_DISABLE" value="0b0" description="Disable"/>
      <bit_field_value name="OPAMP_CTR_EN_ENABLE" value="0b1" description="Enable"/>
    </bit_field>
    <bit_field offset="1" width="1" name="MODE" access="RW" reset_value="0" description="Mode Selection">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_MODE(x)"/>
      <bit_field_value name="OPAMP_CTR_MODE_LOW" value="0b0" description="High performance mode"/>
      <bit_field_value name="OPAMP_CTR_MODE_HIGH" value="0b1" description="Low power mode"/>
    </bit_field>
    <bit_field offset="2" width="2" name="BIASC" access="RW" reset_value="0" description="Bias Current Trim Selection">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_BIASC(x)"/>
      <bit_field_value name="OPAMP_CTR_BIASC_DEF" value="0b00" description="Default"/>
      <bit_field_value name="OPAMP_CTR_BIASC_INC" value="0b01" description="Increase current"/>
      <bit_field_value name="OPAMP_CTR_BIASC_DEC" value="0b10" description="Decrease current"/>
      <bit_field_value name="OPAMP_CTR_BIASC_FUR_DEC" value="0b11" description="Further decrease current"/>
    </bit_field>
    <bit_field offset="4" width="2" name="INTREF" access="RW" reset_value="0" description="Provide OPAMP rail to rail voltage selection">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_INTREF(x)"/>
      <bit_field_value name="OPAMP_CTR_INTREF_VDDA2" value="0b00" description="Select OPAMP input rail to rail voltage from 0 to VDD_ANA"/>
      <bit_field_value name="OPAMP_CTR_INTREF_VDDA3V" value="0b01" description="Select OPAMP input rail to rail voltage from 0 to VDD_ANA-0.8V"/>
      <bit_field_value name="OPAMP_CTR_INTREF_VSSA3V" value="0b10" description="Select OPAMP input rail to rail voltage from 0.8V to VDD_ANA"/>
      <bit_field_value name="OPAMP_CTR_INTREF_NOT" value="0b11" description="Not allowed"/>
    </bit_field>
    <reserved_bit_field offset="6" width="2" reset_value="0"/>
    <bit_field offset="8" width="1" name="TRIGMD" access="RW" reset_value="0" description="Trigger Mode">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_TRIGMD(x)"/>
      <bit_field_value name="OPAMP_CTR_TRIGMD_DISABLE" value="0b0" description="Disable"/>
      <bit_field_value name="OPAMP_CTR_TRIGMD_ENABLE" value="0b1" description="Enable"/>
    </bit_field>
    <bit_field offset="9" width="1" name="INPSEL" access="RW" reset_value="0" description="Positive Input Channel Selection">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_INPSEL(x)"/>
      <bit_field_value name="OPAMP_CTR_INPSEL_INP0" value="0b0" description="When OPAMP is not in trigger mode, select positive input 0 (INP0)"/>
      <bit_field_value name="OPAMP_CTR_INPSEL_INP1" value="0b1" description="When OPAMP is not in trigger mode, select positive input 1 (INP1)"/>
    </bit_field>
    <reserved_bit_field offset="10" width="2" reset_value="0"/>
    <bit_field offset="12" width="1" name="INPF" access="RO" reset_value="0" description="Positive Input Connection Status">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_INPF(x)"/>
      <bit_field_value name="OPAMP_CTR_INPF_INP0" value="0b0" description="Positive input 0 (INP0)"/>
      <bit_field_value name="OPAMP_CTR_INPF_INP1" value="0b1" description="Positive input 1 (INP1)"/>
    </bit_field>
    <reserved_bit_field offset="13" width="3" reset_value="0"/>
    <bit_field offset="16" width="1" name="BUFEN" access="RW" reset_value="0" description="Reference Buffer">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_BUFEN(x)"/>
      <bit_field_value name="OPAMP_CTR_BUFEN_DISABLE" value="0b0" description="Disables"/>
      <bit_field_value name="OPAMP_CTR_BUFEN_ENABLE" value="0b1" description="Enables"/>
    </bit_field>
    <bit_field offset="17" width="2" name="PREF" access="RW" reset_value="0" description="Positive Reference Voltage Selection">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_PREF(x)"/>
      <bit_field_value name="OPAMP_CTR_PREF_VAL0" value="0b00" description="Input 0"/>
      <bit_field_value name="OPAMP_CTR_PREF_VAL1" value="0b01" description="Input 1"/>
      <bit_field_value name="OPAMP_CTR_PREF_VAL2" value="0b10" description="Input 2"/>
      <bit_field_value name="OPAMP_CTR_PREF_VAL3" value="0b11" description="Input 3"/>
    </bit_field>
    <reserved_bit_field offset="19" width="1" reset_value="0"/>
    <bit_field offset="20" width="1" name="ADCSW1" access="RW" reset_value="0" description="Measure Switch 1">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_ADCSW1(x)"/>
      <bit_field_value name="OPAMP_CTR_ADCSW1_OFF" value="0b0" description="Measure negative gain resistor ladder voltage switch off"/>
      <bit_field_value name="OPAMP_CTR_ADCSW1_ON" value="0b1" description="Measure negative gain resistor ladder voltage switch on"/>
    </bit_field>
    <bit_field offset="21" width="1" name="ADCSW2" access="RW" reset_value="0" description="Measure Switch 2">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_ADCSW2(x)"/>
      <bit_field_value name="OPAMP_CTR_ADCSW2_DISABLE" value="0b0" description="Measure positive gain resistor ladder reference voltage switch off"/>
      <bit_field_value name="OPAMP_CTR_ADCSW2_ENABLE" value="0b1" description="Measure positive gain resistor ladder reference voltage switch on"/>
    </bit_field>
    <bit_field offset="22" width="1" name="OUTSW" access="RW" reset_value="0" description="Output Switch">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_OUTSW(x)"/>
      <bit_field_value name="OPAMP_CTR_OUTSW_OFF" value="0b0" description="OPAMP out to negative gain resistor ladder switch off"/>
      <bit_field_value name="OPAMP_CTR_OUTSW_ON" value="0b1" description="OPAMP out to negative gain resistor ladder switch on"/>
    </bit_field>
    <reserved_bit_field offset="23" width="1" reset_value="0"/>
    <bit_field offset="24" width="3" name="PGAIN" access="RW" reset_value="0x1" description="Positive PGA Selection">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_PGAIN(x)"/>
      <bit_field_value name="OPAMP_CTR_PGAIN_INP1" value="0b000" description="Positive input 1 (INP1)"/>
      <bit_field_value name="OPAMP_CTR_PGAIN_G2" value="0b001" description="Pgain=1"/>
      <bit_field_value name="OPAMP_CTR_PGAIN_G3" value="0b010" description="Pgain=2"/>
      <bit_field_value name="OPAMP_CTR_PGAIN_G5" value="0b011" description="Pgain=4"/>
      <bit_field_value name="OPAMP_CTR_PGAIN_G9" value="0b100" description="Pgain=8"/>
      <bit_field_value name="OPAMP_CTR_PGAIN_G17" value="0b101" description="Pgain=16"/>
      <bit_field_value name="OPAMP_CTR_PGAIN_G34" value="0b110" description="Pgain=33"/>
      <bit_field_value name="OPAMP_CTR_PGAIN_G65" value="0b111" description="Pgain=64"/>
    </bit_field>
    <reserved_bit_field offset="27" width="1" reset_value="0"/>
    <bit_field offset="28" width="3" name="NGAIN" access="RW" reset_value="0" description="Negative PGA Selection">
      <alias type="CMSIS" value="OPAMP_OPAMP_CTR_NGAIN(x)"/>
      <bit_field_value name="OPAMP_CTR_NGAIN_BUFFER" value="0b000" description="Buffer"/>
      <bit_field_value name="OPAMP_CTR_NGAIN_G1" value="0b001" description="Ngain=1"/>
      <bit_field_value name="OPAMP_CTR_NGAIN_G2" value="0b010" description="Ngain=2"/>
      <bit_field_value name="OPAMP_CTR_NGAIN_G4" value="0b011" description="Ngain=4"/>
      <bit_field_value name="OPAMP_CTR_NGAIN_G8" value="0b100" description="Ngain=8"/>
      <bit_field_value name="OPAMP_CTR_NGAIN_G16" value="0b101" description="Ngain=16"/>
      <bit_field_value name="OPAMP_CTR_NGAIN_G33" value="0b110" description="Ngain=33"/>
      <bit_field_value name="OPAMP_CTR_NGAIN_G64" value="0b111" description="Ngain=64"/>
    </bit_field>
    <reserved_bit_field offset="31" width="1" reset_value="0"/>
  </register>
</regs:peripheral>