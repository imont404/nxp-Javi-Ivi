            "x_max": 11320.0,
            "y_max": 4100.0
          }
        },
        {
          "text": "ADR/CON_DET:\nWhen Power-up, ADR(input) function:\nADR=1: I2C Address: 0x7A(ADR) \nADR=0: I2C Address: 0x3A(ADR) \nADR=MID/FLOATING\nAfter TINPUTLATCH, CON_DET(output) function:\nCON_DET=1: Connection Detected\nCON_DET=0: No Connection",
          "position_mils": {
            "x": 13300.0,
            "y": 3400.0
          },
          "unique_id": "EUFBYVWW",
          "bounds_mils": {
            "x_min": 13300.0,
            "y_min": 2520.0,
            "x_max": 15640.0,
            "y_max": 3400.0
          }
        },
        {
          "text": "EXT_SEL: External selection\nHigh = CC1 orientation or no valid CC1/CC2 detection\nLow = CC2 orientation\n",
          "position_mils": {
            "x": 16200.0,
            "y": 3400.0
          },
          "unique_id": "XMXXUVMF",
          "bounds_mils": {
            "x_min": 16200.0,
            "y_min": 3070.0,
            "x_max": 18740.0,
            "y_max": 3400.0
          }
        },
        {
          "text": "PORT=:\n1: DFP mode\n0: UFP mode \nFloating: DRP mode ",
          "position_mils": {
            "x": 16200.0,
            "y": 2900.0
          },
          "unique_id": "NLVEBPAH",
          "bounds_mils": {
            "x_min": 16200.0,
            "y_min": 2460.0,
            "x_max": 17170.0,
            "y_max": 2900.0
