# clang-format for the NXP Cup firmware.
#
# Applied to all repository-owned C/C++ through scripts/tools/clang_format.ps1.
# The tree also carries NXP SDK, generated, and imported library sources; those
# remain excluded because reformatting dependencies would bury real changes in
# whitespace. VS Code has format-on-save disabled for the same reason.
#
# Format all owned code, or verify it without changing files:
#   .\scripts\tools\clang_format.ps1
#   .\scripts\tools\clang_format.ps1 -Check
#
# A single file may still be formatted directly with clang-format -i.
BasedOnStyle: LLVM

# The existing hand-written NXP Cup code uses 4 spaces and Allman braces; match it
# rather than LLVM's defaults, so formatted code does not look foreign next to
# the code students are reading.
IndentWidth: 4
TabWidth: 4
UseTab: Never
BreakBeforeBraces: Allman
ColumnLimit: 100

AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
PointerAlignment: Right
SpaceAfterCStyleCast: false
SortIncludes: false
